#: includes/class-admin-settings.php
msgid "SheetSync for CF7"
msgstr "SheetSync for CF7"

#: includes/class-admin-settings.php
msgid "Copy email"
msgstr "Copia email"

#: includes/class-admin-settings.php
msgid "Copied!"
msgstr "Copiata!"

#: includes/class-admin-settings.php
msgid "Copy failed: select the text and press Ctrl+C / Cmd+C."
msgstr "Copia non riuscita: seleziona il testo e premi Ctrl+C / Cmd+C."

#: includes/class-admin-settings.php
msgid "Contacting Google…"
msgstr "Contatto Google in corso…"

#: includes/class-admin-settings.php
msgid "Syncing headers with Google Sheets…"
msgstr "Sincronizzazione delle intestazioni con Google Sheets…"

#: includes/class-admin-settings.php
msgid "Reading the columns of the sheet…"
msgstr "Lettura delle colonne del foglio…"

#: includes/class-admin-settings.php
msgid "The request failed. Check your connection and try again."
msgstr "La richiesta non è andata a buon fine. Controlla la connessione e riprova."

#: includes/class-admin-settings.php
msgid "This is not valid JSON. Paste the whole content of the .json key file."
msgstr "Questo non è un JSON valido. Incolla l'intero contenuto del file chiave .json."

#, php-format
#: includes/class-admin-settings.php
msgid "Required fields missing from the JSON: %s."
msgstr "Campi obbligatori mancanti nel JSON: %s."

#: includes/class-admin-settings.php
msgid "This JSON is not a Service Account key (\"type\" must be \"service_account\")."
msgstr "Questo JSON non è una chiave di Service Account (\"type\" deve essere \"service_account\")."

#: includes/class-admin-settings.php
msgid "This file is too large to be a Service Account key."
msgstr "Il file è troppo grande per essere una chiave di Service Account."

#: includes/class-admin-settings.php
msgid "The file could not be read."
msgstr "Impossibile leggere il file."

#, php-format
#: includes/class-admin-settings.php
msgid "Key loaded for %s. Click \"Save credentials\" to store it."
msgstr "Chiave caricata per %s. Clicca su \"Salva credenziali\" per memorizzarla."

#: includes/class-admin-settings.php
msgid "Upload the JSON key file or paste its content first."
msgstr "Carica prima il file chiave JSON o incollane il contenuto."

#: includes/class-admin-settings.php
msgid "Enter the Spreadsheet ID (or paste the full spreadsheet URL) first."
msgstr "Inserisci prima lo Spreadsheet ID (o incolla l'URL completo del foglio)."

#: includes/class-admin-settings.php
msgid "Columns added:"
msgstr "Colonne aggiunte:"

#: includes/class-admin-settings.php
msgid "Columns in the sheet with no matching field (they will stay empty unless you map them below):"
msgstr "Colonne del foglio senza un campo corrispondente (resteranno vuote, a meno che tu non le mappi qui sotto):"

#: includes/class-admin-settings.php
msgid "Remember to save the form to keep these Google Sheets settings."
msgstr "Ricordati di salvare il modulo per mantenere queste impostazioni di Google Sheets."

#, php-format
#: includes/class-admin-settings.php
msgid "Automatic → %s"
msgstr "Automatico → %s"

#: includes/class-admin-settings.php
msgid "Automatic (no field with this name: stays empty)"
msgstr "Automatico (nessun campo con questo nome: resta vuota)"

#: includes/class-admin-settings.php
msgid "Leave empty"
msgstr "Lascia vuota"

#: includes/class-admin-settings.php
msgid "Custom text…"
msgstr "Testo personalizzato…"

#: includes/class-admin-settings.php
msgid "Form fields"
msgstr "Campi del modulo"

#: includes/class-admin-settings.php
msgid "Metadata"
msgstr "Metadati"

#: includes/class-admin-settings.php
msgid "Lead source (UTM / click ID)"
msgstr "Fonte lead (UTM / click ID)"

#: includes/class-admin-settings.php
msgid "e.g. Google Ads, or [your-name] – [_post_title]"
msgstr "es. Google Ads, oppure [your-name] – [_post_title]"

#, php-format
#: includes/class-admin-settings.php
msgid "%d columns read from the sheet. Choose what to write in each one, then save the form."
msgstr "%d colonne lette dal foglio. Scegli cosa scrivere in ognuna, poi salva il modulo."

#: includes/class-admin-settings.php
msgid "Settings"
msgstr "Impostazioni"

#: includes/class-admin-settings.php
msgid "Dashboard"
msgstr "Dashboard"

#: includes/class-admin-settings.php
msgid "SheetSync for CF7 sections"
msgstr "Sezioni di SheetSync for CF7"

#: includes/class-admin-settings.php
msgid "Send Contact Form 7 submissions to Google Sheets in real time using your own Google Service Account. Your key stays on your site: no third-party servers are involved."
msgstr "Invia in tempo reale gli invii di Contact Form 7 a Google Sheets usando il tuo Google Service Account. La chiave resta sul tuo sito: nessun server di terze parti è coinvolto."

#: includes/class-admin-settings.php
msgid "Date and time format"
msgstr "Formato data e ora"

#: includes/class-admin-settings.php
msgid "Date"
msgstr "Data"

#: includes/class-admin-settings.php
msgid "Time"
msgstr "Ora"

#: includes/class-admin-settings.php
msgid "Do not write the time"
msgstr "Non scrivere l'ora"

#: includes/class-admin-settings.php
msgid "Used for the \"Submission date\" column (site timezone)."
msgstr "Usato per la colonna \"Data e ora invio\" (fuso orario del sito)."

#: includes/class-admin-settings.php
msgid "Date fields"
msgstr "Campi data"

#: includes/class-admin-settings.php
msgid "Use the same date format for the date fields of the forms ([date])"
msgstr "Usa lo stesso formato per i campi data dei moduli ([date])"

#: includes/class-admin-settings.php
msgid "Contact Form 7 sends them as 2026-03-11."
msgstr "Contact Form 7 li invia come 2026-03-11."

#: includes/class-admin-settings.php
msgid "Google Sheets turns the text into a real date (usable with the date picker, filters and formulas) only when the format matches the locale of the spreadsheet: File → Settings → Locale. With \"Italy\" use 11/03/2026; with \"United States\" use 03/11/2026. 2026-03-11 works with every locale."
msgstr "Google Sheets trasforma il testo in una vera data (utilizzabile con il selettore data, i filtri e le formule) solo se il formato corrisponde alle impostazioni internazionali del foglio: File → Impostazioni → Impostazioni internazionali. Con \"Italia\" usa 11/03/2026; con \"Stati Uniti\" usa 03/11/2026. 2026-03-11 funziona con qualsiasi impostazione."

#: includes/class-admin-settings.php
msgid "Save settings"
msgstr "Salva impostazioni"

#: includes/class-admin-settings.php
msgid "Only the page where the visitor lands (nothing stored in the browser)"
msgstr "Solo la pagina di arrivo del visitatore (niente salvato nel browser)"

#: includes/class-admin-settings.php
msgid "7 days"
msgstr "7 giorni"

#: includes/class-admin-settings.php
msgid "30 days"
msgstr "30 giorni"

#: includes/class-admin-settings.php
msgid "90 days"
msgstr "90 giorni"

#: includes/class-admin-settings.php
msgid "Lead source tracking (UTM / gclid)"
msgstr "Tracciamento fonte lead (UTM / gclid)"

#: includes/class-admin-settings.php
msgid "Records where each lead comes from: Google Ads, Meta Ads, organic search, other websites… from the UTM parameters and the ad click IDs (gclid, fbclid, msclkid) of the page where the visitor arrived, even if the form is on another page."
msgstr "Registra da dove arriva ogni lead: Google Ads, Meta Ads, ricerca organica, altri siti… in base ai parametri UTM e agli ID di click degli annunci (gclid, fbclid, msclkid) della pagina di arrivo del visitatore, anche se il modulo si trova su un'altra pagina."

#: includes/class-admin-settings.php
msgid "Tracking"
msgstr "Tracciamento"

#: includes/class-admin-settings.php
msgid "Capture the lead source of every submission"
msgstr "Registra la fonte di ogni lead"

#: includes/class-admin-settings.php
msgid "Adds a small script (about 2 KB, no cookies, no external requests) to the pages of the site."
msgstr "Aggiunge alle pagine del sito un piccolo script (circa 2 KB, senza cookie né richieste esterne)."

#: includes/class-admin-settings.php
msgid "Remember the source for"
msgstr "Ricorda la fonte per"

#: includes/class-admin-settings.php
msgid "With a duration, the campaign is kept in the browser (localStorage) so the lead is attributed even when the visitor comes back later directly."
msgstr "Con una durata, la campagna viene conservata nel browser (localStorage): il lead viene attribuito anche se il visitatore torna più tardi in modo diretto."

#: includes/class-admin-settings.php
msgid "If there are several visits"
msgstr "Se ci sono più visite"

#: includes/class-admin-settings.php
msgid "Last campaign click (recommended)"
msgstr "Ultimo click di campagna (consigliato)"

#: includes/class-admin-settings.php
msgid "First campaign click"
msgstr "Primo click di campagna"

#: includes/class-admin-settings.php
msgid "Direct visits never replace a campaign."
msgstr "Le visite dirette non sostituiscono mai una campagna."

#: includes/class-admin-settings.php
msgid "Cookie consent"
msgstr "Consenso cookie"

#: includes/class-admin-settings.php
msgid "Remember the source only with the visitor's marketing consent"
msgstr "Ricorda la fonte solo con il consenso marketing del visitatore"

#: includes/class-admin-settings.php
msgid "Uses the WP Consent API, supported by Complianz, CookieYes, Cookiebot, Real Cookie Banner and others. Without consent the source is still read from the page where the form is sent, but nothing is stored in the browser."
msgstr "Usa la WP Consent API, supportata da Complianz, CookieYes, Cookiebot, Real Cookie Banner e altri. Senza consenso la fonte viene comunque letta dalla pagina in cui si invia il modulo, ma nel browser non viene salvato nulla."

#: includes/class-admin-settings.php
msgid "WP Consent API not detected: until you install it (with a compatible cookie banner), the source is read only from the page where the form is sent."
msgstr "WP Consent API non rilevata: finché non la installi (con un banner cookie compatibile), la fonte viene letta solo dalla pagina in cui si invia il modulo."

#: includes/class-admin-settings.php
msgid "Channel names"
msgstr "Nomi dei canali"

#: includes/class-admin-settings.php
msgid "What is written in the \"Lead source\" column for each channel. Leave empty to use the default name."
msgstr "Cosa viene scritto nella colonna \"Fonte lead\" per ogni canale. Lascia vuoto per usare il nome predefinito."

#: includes/class-admin-settings.php
msgid "Then, in the Google Sheets tab of each form, tick the \"Lead source\" columns or map a column of your sheet (e.g. \"Lead type\") to \"Lead source\". The same values are available as mail-tags for the CF7 emails and the custom texts:"
msgstr "Poi, nel tab Google Sheets di ogni modulo, spunta le colonne \"Fonte lead\" oppure mappa una colonna del foglio (es. \"Tipologia Lead\") su \"Fonte lead\". Gli stessi valori sono disponibili come mail-tag nelle email di CF7 e nei testi personalizzati:"

#: includes/class-admin-settings.php
msgid "Quick start guide: connect Google Sheets in 4 steps"
msgstr "Guida rapida: collega Google Sheets in 4 passaggi"

#: includes/class-admin-settings.php
msgid "Create a Google Cloud project"
msgstr "Crea un progetto Google Cloud"

#, php-format
#: includes/class-admin-settings.php
msgid "Open the <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Google Cloud Console</a> and create a new project (or select an existing one). It is free: no billing account is needed for the Sheets API."
msgstr "Apri la <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Google Cloud Console</a> e crea un nuovo progetto (o selezionane uno esistente). È gratuito: per le Sheets API non serve un account di fatturazione."

#: includes/class-admin-settings.php
msgid "Enable the Google Sheets API"
msgstr "Abilita le Google Sheets API"

#, php-format
#: includes/class-admin-settings.php
msgid "Open the <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Google Sheets API page</a>, check that your project is selected at the top, and click <strong>Enable</strong>."
msgstr "Apri la <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">pagina delle Google Sheets API</a>, verifica che in alto sia selezionato il tuo progetto e clicca su <strong>Abilita</strong>."

#: includes/class-admin-settings.php
msgid "Create a Service Account and download its JSON key"
msgstr "Crea un Service Account e scarica la chiave JSON"

#, php-format
#: includes/class-admin-settings.php
msgid "Go to <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">IAM &amp; Admin → Service Accounts</a>, click <strong>Create service account</strong> and give it a name (no roles are needed). Then open it, go to the <strong>Keys</strong> tab → <strong>Add key</strong> → <strong>Create new key</strong> → <strong>JSON</strong>. A <code>.json</code> file is downloaded: upload it in the box below."
msgstr "Vai su <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">IAM e amministrazione → Account di servizio</a>, clicca su <strong>Crea account di servizio</strong> e dagli un nome (non servono ruoli). Poi aprilo, vai nella scheda <strong>Chiavi</strong> → <strong>Aggiungi chiave</strong> → <strong>Crea nuova chiave</strong> → <strong>JSON</strong>. Verrà scaricato un file <code>.json</code>: caricalo nel riquadro qui sotto."

#: includes/class-admin-settings.php
msgid "Share your spreadsheet with the Service Account"
msgstr "Condividi il foglio con il Service Account"

#: includes/class-admin-settings.php
msgid "Open your Google Sheet, click <strong>Share</strong>, paste the Service Account email and grant <strong>Editor</strong> access. Repeat for every spreadsheet you want to use."
msgstr "Apri il tuo Google Sheet, clicca su <strong>Condividi</strong>, incolla l'email del Service Account e assegna il ruolo <strong>Editor</strong>. Ripeti per ogni foglio che vuoi usare."

#: includes/class-admin-settings.php
msgid "Treat the JSON file like a password: don't email it or commit it to public repositories, and delete it from your computer after uploading. If your Google Workspace organization blocks key creation, ask your Workspace administrator."
msgstr "Tratta il file JSON come una password: non inviarlo via email né caricarlo in repository pubblici, ed eliminalo dal computer dopo il caricamento. Se la tua organizzazione Google Workspace blocca la creazione delle chiavi, rivolgiti all'amministratore di Workspace."

#: includes/class-admin-settings.php
msgid "Google Service Account"
msgstr "Google Service Account"

#: includes/class-admin-settings.php
msgid "Connected"
msgstr "Connesso"

#: includes/class-admin-settings.php
msgid "Share every spreadsheet you want to use with this email, as <strong>Editor</strong>:"
msgstr "Condividi ogni foglio che vuoi usare con questa email, come <strong>Editor</strong>:"

#: includes/class-admin-settings.php
msgid "Service Account email"
msgstr "Email del Service Account"

#, php-format
#: includes/class-admin-settings.php
msgid "Project: %s"
msgstr "Progetto: %s"

#, php-format
#: includes/class-admin-settings.php
msgid "Saved on %s"
msgstr "Salvato il %s"

#: includes/class-admin-settings.php
msgid "The private key is stored encrypted and is never displayed."
msgstr "La chiave privata è salvata cifrata e non viene mai mostrata."

#: includes/class-admin-settings.php
msgid "Test connection"
msgstr "Testa connessione"

#: includes/class-admin-settings.php
msgid "Remove the Service Account credentials? Your forms will stop sending data to Google Sheets until you add a new key."
msgstr "Rimuovere le credenziali del Service Account? I moduli smetteranno di inviare dati a Google Sheets finché non aggiungerai una nuova chiave."

#: includes/class-admin-settings.php
msgid "Remove / Replace credentials"
msgstr "Rimuovi / Sostituisci credenziali"

#: includes/class-admin-settings.php
msgid "Not connected"
msgstr "Non connesso"

#: includes/class-admin-settings.php
msgid "Upload the JSON key file"
msgstr "Carica il file chiave JSON"

#: includes/class-admin-settings.php
msgid "…or paste its content"
msgstr "…oppure incollane il contenuto"

#: includes/class-admin-settings.php
msgid "The file is read in your browser and sent only to your own WordPress site. The private key is encrypted before being saved and will never be shown again."
msgstr "Il file viene letto nel tuo browser e inviato solo al tuo sito WordPress. La chiave privata viene cifrata prima del salvataggio e non sarà più mostrata."

#: includes/class-admin-settings.php
msgid "Save credentials"
msgstr "Salva credenziali"

#: includes/class-admin-settings.php
msgid "Forever"
msgstr "Per sempre"

#: includes/class-admin-settings.php
msgid "6 months"
msgstr "6 mesi"

#: includes/class-admin-settings.php
msgid "1 year"
msgstr "1 anno"

#: includes/class-admin-settings.php
msgid "2 years"
msgstr "2 anni"

#: includes/class-admin-settings.php
msgid "Archive, retries and alerts"
msgstr "Archivio, nuovi tentativi e avvisi"

#: includes/class-admin-settings.php
msgid "Local copy"
msgstr "Copia locale"

#: includes/class-admin-settings.php
msgid "Save a copy of every submission in WordPress"
msgstr "Salva una copia di ogni invio in WordPress"

#: includes/class-admin-settings.php
msgid "Needed for the Dashboard, to resend submissions that failed and to export them as CSV. Nothing is lost even if Google Sheets is unreachable."
msgstr "Serve per la Dashboard, per reinviare gli invii non riusciti e per esportarli in CSV. Nessun dato va perso anche se Google Sheets non è raggiungibile."

#: includes/class-admin-settings.php
msgid "Keep entries for"
msgstr "Conserva gli invii per"

#: includes/class-admin-settings.php
msgid "Older entries are deleted automatically once a day (only from WordPress, never from Google Sheets). Entries contain personal data: keep them only as long as you need them (GDPR)."
msgstr "Gli invii più vecchi vengono eliminati automaticamente una volta al giorno (solo da WordPress, mai da Google Sheets). Gli invii contengono dati personali: conservali solo per il tempo necessario (GDPR)."

#: includes/class-admin-settings.php
msgid "Automatic retry"
msgstr "Nuovo tentativo automatico"

#: includes/class-admin-settings.php
msgid "Send failed submissions again automatically"
msgstr "Reinvia automaticamente gli invii non riusciti"

#: includes/class-admin-settings.php
msgid "Maximum attempts"
msgstr "Tentativi massimi"

#: includes/class-admin-settings.php
msgid "Runs in the background about once an hour, waiting longer after each failure (1, 2, 4, 8 hours…), so a temporary Google outage or quota limit is recovered without losing leads. Requires the local copy."
msgstr "Funziona in background circa una volta all'ora, aspettando sempre di più dopo ogni errore (1, 2, 4, 8 ore…): così un disservizio temporaneo di Google o un limite di quota si risolvono senza perdere lead. Richiede la copia locale."

#: includes/class-admin-settings.php
msgid "Email alerts"
msgstr "Avvisi email"

#: includes/class-admin-settings.php
msgid "Email me when a submission cannot be sent to Google Sheets"
msgstr "Avvisami via email quando un invio non arriva a Google Sheets"

#: includes/class-admin-settings.php
msgid "Recipients"
msgstr "Destinatari"

#, php-format
#: includes/class-admin-settings.php
msgid "Separate multiple addresses with commas. Leave empty to use the site admin email (%s)."
msgstr "Separa più indirizzi con una virgola. Lascia vuoto per usare l'email dell'amministratore del sito (%s)."

#: includes/class-admin-settings.php
msgid "You get an email when a submission fails and, if it is retried automatically, only again when the last attempt fails. At most one email per hour; the submitted data is never included."
msgstr "Ricevi un'email quando un invio fallisce e, se viene ritentato in automatico, di nuovo solo quando fallisce anche l'ultimo tentativo. Al massimo un'email all'ora; i dati inviati non sono mai inclusi."

#: includes/class-admin-settings.php
msgid "Save and send a test email"
msgstr "Salva e invia un'email di prova"

#: includes/class-admin-settings.php
msgid "The local copy is disabled: there is nothing to retry. Enable \"Save a copy of every submission in WordPress\"."
msgstr "La copia locale è disattivata: non c'è niente da ritentare. Attiva \"Salva una copia di ogni invio in WordPress\"."

#: includes/class-admin-settings.php
msgid "WP-Cron is disabled on this site (DISABLE_WP_CRON): make sure a server cron job calls wp-cron.php, otherwise the automatic retry never runs."
msgstr "WP-Cron è disattivato su questo sito (DISABLE_WP_CRON): assicurati che un cron job del server richiami wp-cron.php, altrimenti il nuovo tentativo automatico non parte mai."

#, php-format
#: includes/class-admin-settings.php
msgid "Next check: %s."
msgstr "Prossimo controllo: %s."

#: includes/class-admin-settings.php
msgid "Connected forms"
msgstr "Moduli collegati"

#, php-format
#: includes/class-admin-settings.php
msgid "No form configured yet. Open a form in <a href=\"%s\">Contact → Contact Forms</a> and use the <strong>Google Sheets</strong> tab."
msgstr "Nessun modulo configurato. Apri un modulo in <a href=\"%s\">Contatto → Moduli di contatto</a> e usa la scheda <strong>Google Sheets</strong>."

#: includes/class-admin-settings.php
msgid "Form"
msgstr "Modulo"

#: includes/class-admin-settings.php
msgid "Status"
msgstr "Stato"

#: includes/class-admin-settings.php
msgid "Spreadsheet"
msgstr "Foglio"

#: includes/class-admin-settings.php
msgid "Tab"
msgstr "Scheda"

#: includes/class-admin-settings.php
msgid "Active"
msgstr "Attivo"

#: includes/class-admin-settings.php
msgid "Disabled"
msgstr "Disattivato"

#: includes/class-admin-settings.php
msgid "first tab"
msgstr "prima scheda"

#, php-format
#: includes/class-admin-settings.php
msgid "Credentials saved, but the connection test failed: %s"
msgstr "Credenziali salvate, ma il test di connessione non è riuscito: %s"

#, php-format
#: includes/class-admin-settings.php
msgid "Credentials saved and connection to Google verified. Now share your spreadsheets with %s as Editor."
msgstr "Credenziali salvate e connessione a Google verificata. Ora condividi i tuoi fogli con %s come Editor."

#: includes/class-admin-settings.php
msgid "Credentials removed. You can now upload a new JSON key."
msgstr "Credenziali rimosse. Ora puoi caricare una nuova chiave JSON."

#: includes/class-admin-settings.php
msgid "Settings saved, but there is no valid recipient for the test email."
msgstr "Impostazioni salvate, ma non c'è un destinatario valido per l'email di prova."

#, php-format
#: includes/class-admin-settings.php
msgid "Settings saved. Test email sent to %s: if it does not arrive, check the spam folder and the email settings of the site (an SMTP plugin is recommended)."
msgstr "Impostazioni salvate. Email di prova inviata a %s: se non arriva, controlla lo spam e le impostazioni email del sito (consigliato un plugin SMTP)."

#: includes/class-admin-settings.php
msgid "Settings saved, but WordPress could not send the test email. Check the email settings of the site (an SMTP plugin is recommended)."
msgstr "Impostazioni salvate, ma WordPress non è riuscito a inviare l'email di prova. Controlla le impostazioni email del sito (consigliato un plugin SMTP)."

#: includes/class-admin-settings.php
msgid "Settings saved."
msgstr "Impostazioni salvate."

#: includes/class-admin-settings.php
msgid "You are not allowed to perform this action."
msgstr "Non hai i permessi per eseguire questa azione."

#: includes/class-admin-settings.php
msgid "Security check failed. Reload the page and try again."
msgstr "Controllo di sicurezza non riuscito. Ricarica la pagina e riprova."

#, php-format
#: includes/class-admin-settings.php
msgid "Connection successful! Google issued an access token for %s."
msgstr "Connessione riuscita! Google ha rilasciato un access token per %s."

#: includes/class-admin-settings.php
msgid "No Service Account configured. Go to Contact → SheetSync for CF7 first."
msgstr "Nessun Service Account configurato. Vai prima in Contatto → SheetSync for CF7."

#: includes/class-admin-settings.php
msgid "The Spreadsheet ID is missing or not valid."
msgstr "Lo Spreadsheet ID manca o non è valido."

#, php-format
#: includes/class-admin-settings.php
msgid "The tab \"%1$s\" does not exist in \"%2$s\". Available tabs: %3$s. The name is case-sensitive."
msgstr "La scheda \"%1$s\" non esiste in \"%2$s\". Schede disponibili: %3$s. Il nome distingue maiuscole e minuscole."

#: includes/class-admin-settings.php
msgid "Row 1 of the sheet is empty. Click \"Sync headers\" first, or write the column names in row 1."
msgstr "La riga 1 del foglio è vuota. Clicca prima su \"Sincronizza intestazioni\" oppure scrivi i nomi delle colonne nella riga 1."

#: includes/class-admin-settings.php
msgid "Save the form at least once before syncing the headers."
msgstr "Salva il modulo almeno una volta prima di sincronizzare le intestazioni."

#: includes/class-admin-settings.php
msgid "This form has no fields that can be sent to Google Sheets."
msgstr "Questo modulo non ha campi che possano essere inviati a Google Sheets."

#, php-format
#: includes/class-admin-settings.php
msgid "Headers already up to date in \"%1$s\" › %2$s."
msgstr "Intestazioni già aggiornate in \"%1$s\" › %2$s."

#: includes/class-admin-settings.php
msgid "Google Sheets"
msgstr "Google Sheets"

#: includes/class-admin-settings.php
msgid "Only administrators can configure the Google Sheets integration."
msgstr "Solo gli amministratori possono configurare l'integrazione con Google Sheets."

#, php-format
#: includes/class-admin-settings.php
msgid "No Google Service Account configured yet. <a href=\"%s\">Configure it in Contact → SheetSync for CF7</a> first."
msgstr "Nessun Google Service Account configurato. <a href=\"%s\">Configuralo prima in Contatto → SheetSync for CF7</a>."

#: includes/class-admin-settings.php
