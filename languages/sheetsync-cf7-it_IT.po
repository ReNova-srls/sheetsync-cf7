#: includes/class-google-auth.php
msgid "Paste the content of the Service Account JSON file (or upload the .json file)."
msgstr "Incolla il contenuto del file JSON del Service Account (o carica il file .json)."

#: includes/class-google-auth.php
msgid "The JSON is too large to be a Service Account key."
msgstr "Il JSON è troppo grande per essere una chiave di Service Account."

#: includes/class-google-auth.php
msgid "The text is not valid JSON. Paste the whole content of the .json file downloaded from Google Cloud Console."
msgstr "Il testo non è un JSON valido. Incolla l'intero contenuto del file .json scaricato dalla Google Cloud Console."

#: includes/class-google-auth.php
msgid "This JSON is not a Service Account key (the \"type\" field must be \"service_account\"). Make sure you created a key for a Service Account, not an OAuth client ID."
msgstr "Questo JSON non è una chiave di Service Account (il campo \"type\" deve essere \"service_account\"). Verifica di aver creato una chiave per un Service Account e non un ID client OAuth."

#: includes/class-google-auth.php
msgid "The \"client_email\" field is not a valid email address."
msgstr "Il campo \"client_email\" non è un indirizzo email valido."

#: includes/class-google-auth.php
msgid "The \"token_uri\" field must be an official Google HTTPS endpoint (e.g. https://oauth2.googleapis.com/token)."
msgstr "Il campo \"token_uri\" deve essere un endpoint HTTPS ufficiale di Google (es. https://oauth2.googleapis.com/token)."

#: includes/class-google-auth.php
msgid "The \"private_key\" field does not contain a PEM private key."
msgstr "Il campo \"private_key\" non contiene una chiave privata PEM."

#: includes/class-google-auth.php
msgid "OpenSSL could not read the \"private_key\". The JSON may be truncated or modified: download a new key from Google Cloud Console."
msgstr "OpenSSL non riesce a leggere la \"private_key\". Il JSON potrebbe essere incompleto o modificato: scarica una nuova chiave dalla Google Cloud Console."

#: includes/class-google-auth.php
msgid "The private key is not an RSA key, which is required by Google (RS256)."
msgstr "La chiave privata non è una chiave RSA, richiesta da Google (RS256)."

#: includes/class-google-auth.php
msgid "Could not save the credentials to the database."
msgstr "Impossibile salvare le credenziali nel database."

#: includes/class-google-auth.php
msgid "No Service Account configured. Go to Contact → SheetSync for CF7 and add your JSON key."
msgstr "Nessun Service Account configurato. Vai in Contatto → SheetSync for CF7 e aggiungi la tua chiave JSON."

#: includes/class-google-auth.php
msgid "The stored credentials are corrupted. Remove them and upload the JSON key again."
msgstr "Le credenziali salvate sono danneggiate. Rimuovile e carica di nuovo la chiave JSON."

#, php-format
#: includes/class-google-auth.php
msgid "Could not reach the Google authentication server: %s"
msgstr "Impossibile raggiungere il server di autenticazione Google: %s"

#: includes/class-google-auth.php
msgid "OpenSSL could not read the stored private key. Remove the credentials and upload the JSON key again."
msgstr "OpenSSL non riesce a leggere la chiave privata salvata. Rimuovi le credenziali e carica di nuovo la chiave JSON."

#: includes/class-google-auth.php
msgid "OpenSSL failed to sign the authentication request (RS256)."
msgstr "OpenSSL non è riuscito a firmare la richiesta di autenticazione (RS256)."

#: includes/class-google-auth.php
msgid "Google rejected the key: it may have been deleted or disabled in Google Cloud Console, or the Service Account no longer exists. Create a new JSON key and upload it again."
msgstr "Google ha rifiutato la chiave: potrebbe essere stata eliminata o disattivata nella Google Cloud Console, oppure il Service Account non esiste più. Crea una nuova chiave JSON e caricala di nuovo."

#: includes/class-google-auth.php
msgid "Google rejected the request time: the server clock seems wrong. Ask your hosting provider to synchronize it (NTP)."
msgstr "Google ha rifiutato l'orario della richiesta: l'orologio del server sembra sbagliato. Chiedi al tuo provider di hosting di sincronizzarlo (NTP)."

#: includes/class-google-auth.php
msgid "Google rejected the Service Account credentials."
msgstr "Google ha rifiutato le credenziali del Service Account."

#: includes/class-google-auth.php
msgid "Could not obtain an access token from Google."
msgstr "Impossibile ottenere un access token da Google."

#, php-format
#: includes/class-google-auth.php
msgid "%1$s (HTTP %2$d: %3$s)"
msgstr "%1$s (HTTP %2$d: %3$s)"

#, php-format
#: includes/class-google-auth.php
msgid "Could not reach the Google Sheets API: %s"
msgstr "Impossibile raggiungere le Google Sheets API: %s"

#: includes/class-google-auth.php
msgid "The Google Sheets API is not enabled for this Google Cloud project. Enable it in Google Cloud Console (APIs & Services → Library → Google Sheets API) and try again in a few minutes."
msgstr "Le Google Sheets API non sono abilitate per questo progetto Google Cloud. Abilitale nella Google Cloud Console (API e servizi → Libreria → Google Sheets API) e riprova tra qualche minuto."

#, php-format
#: includes/class-google-auth.php
msgid "Access denied. Open the spreadsheet in Google Sheets, click \"Share\" and add %s as Editor."
msgstr "Accesso negato. Apri il foglio in Google Sheets, clicca su \"Condividi\" e aggiungi %s come Editor."

#: includes/class-google-auth.php
msgid "Spreadsheet not found. Check the Spreadsheet ID."
msgstr "Foglio non trovato. Controlla lo Spreadsheet ID."

#: includes/class-google-auth.php
msgid "Sheet tab not found. Check the tab name (it is case-sensitive and must match exactly)."
msgstr "Scheda non trovata. Controlla il nome della scheda (distingue maiuscole e minuscole e deve corrispondere esattamente)."

#: includes/class-google-auth.php
msgid "Google Sheets API quota exceeded. Wait a minute and try again."
msgstr "Quota delle Google Sheets API superata. Attendi un minuto e riprova."

#: includes/class-google-auth.php
msgid "Google Sheets is temporarily unavailable. Try again later."
msgstr "Google Sheets è temporaneamente non disponibile. Riprova più tardi."

#: includes/class-google-auth.php
msgid "The Google Sheets API returned an error."
msgstr "Le Google Sheets API hanno restituito un errore."

#: includes/class-google-auth.php
msgid "The server OpenSSL library does not support AES-256-GCM, required to store the credentials securely."
msgstr "La libreria OpenSSL del server non supporta AES-256-GCM, necessario per salvare le credenziali in modo sicuro."

#: includes/class-google-auth.php
msgid "Could not generate secure random bytes on this server."
msgstr "Impossibile generare byte casuali sicuri su questo server."

#: includes/class-google-auth.php
msgid "Could not encrypt the credentials."
msgstr "Impossibile cifrare le credenziali."

#: includes/class-google-auth.php
msgid "The stored credentials can no longer be decrypted (the WordPress security keys in wp-config.php may have changed). Remove them and upload the JSON key again."
msgstr "Le credenziali salvate non possono più essere decifrate (le chiavi di sicurezza di WordPress in wp-config.php potrebbero essere cambiate). Rimuovile e carica di nuovo la chiave JSON."

